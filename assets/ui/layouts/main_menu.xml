<UI styles="common.xml">

    <!-- Base фон панели: #0F1115 → 0.06, 0.07, 0.08, 0.94 -->
    <!-- Корневая панель центрируется по экрану -->
    <Panel id="mainPanel"
           x="0"
           y="0"
           width="500"
           height="500"
           style="menuPanel"
           anchor="Center">

        <!-- Неоновая линия сверху: #00F0FF -->
        <Panel x="0" y="0"
               width="500" height="5"
               style="accent"
               anchor="TopLeft" />

        <!-- Заголовок: #00F0FF (главный акцент) -->
        <Label id="titleLabel"
               x="0" y="45"
               width="500" height="70"
               text="LINDO"
               style="title"
               anchor="TopCenter" />

        <!-- Подзаголовок: #64748B (приглушённый текст) -->
        <Label id="subtitleLabel"
               x="0" y="112"
               width="500" height="35"
               text="3D СИМУЛЯЦИЯ МИРА"
               style="mutedLabel"
               anchor="TopLeft" />

        <!-- Разделитель: #0F172A -->
        <Panel x="65" y="165"
               width="370" height="1"
               style="divider"
               anchor="TopLeft" />

        <!-- Кнопка Play: основной бренд #008DFF -->
        <Button id="playButton"
                x="50" y="195"
                width="400" height="58"
                text="НАЧАТЬ ИГРУ"
                onClick="play"
                style="primaryButton"
                anchor="TopLeft" />

        <!-- Кнопка Настройки: вторичная панель #1E293B + текст #E2E8F0 -->
        <Button id="settingsButton"
                x="50" y="265"
                width="400" height="52"
                text="НАСТРОЙКИ"
                onClick="openSettings"
                style="secondaryButton"
                anchor="TopLeft" />

        <!-- Кнопка Выход: вторичная панель #1E293B + приглушённый текст #64748B -->
        <Button id="quitButton"
                x="50" y="329"
                width="400" height="52"
                text="ВЫХОД"
                onClick="quit"
                style="secondaryButton, mutedLabel"
                anchor="TopLeft" />

        <!-- Версия: приглушённый текст #64748B -->
        <Label id="versionLabel"
               x="25" y="430"
               width="450" height="25"
               text=""
               style="mutedLabel"
               anchor="TopLeft" />

        <!-- Билд: ещё тише — используем #0F172A (границы) как «тень» -->
        <Label id="buildLabel"
               x="25" y="455"
               width="450" height="25"
               text=""
               style="divider"
               anchor="TopLeft" />

    </Panel>

</UI>